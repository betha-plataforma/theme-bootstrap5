{
  "name": "@betha-plataforma/theme-bootstrap5",
  "version": "1.2.2",
  "description": "Tema do Design System Betha para Bootstrap 5",
  "main": "dist/theme-bootstrap5.css",
  "unpkg": "dist/theme-bootstrap5.min.css",
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "sass": "1.98.0"
  },
  "scripts": {
    "copy:fonts": "node scripts/copy-fonts.js",
    "start": "run-s copy:fonts start:css",
    "start:css": "sass --watch src/all.scss dist/theme-bootstrap5.css",
    "build": "run-s copy:fonts build:compressed build:expanded",
    "build:compressed": "sass src/all.scss:dist/theme-bootstrap5.min.css --style=compressed",
    "build:expanded": "sass src/all.scss:dist/theme-bootstrap5.css --style=expanded"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/betha-plataforma/theme-bootstrap5.git"
  },
  "keywords": [
    "bootstrap theme",
    "design system betha",
    "plataforma",
    "betha cloud"
  ],
  "author": {
    "name": "Plataforma Betha Cloud",
    "email": "ti.plataforma@betha.com.br",
    "url": "https://plataforma.betha.cloud/"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/betha-plataforma/theme-bootstrap5/issues"
  },
  "homepage": "https://github.com/betha-plataforma/theme-bootstrap5#readme"
}
